# 高层 Agno 模型：DeepSeek V4 Pro（OpenAI 兼容接口）
MODEL_PROVIDER=openai_like
MODEL_ID=deepseek-v4-pro
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Agno supervisor 记忆库
DB_FILE=data/supervisor_memory.db

# 中层 VLA：NaVILA HTTP bridge（--vla=http/navila 时使用）
NAVILA_ENDPOINT=http://127.0.0.1:8011

# 中层 VLA：LightNav-0 WebSocket server（--vla=lightnav 时使用）
LIGHTNAV_ENDPOINT=ws://127.0.0.1:8050

# 底层机器人：Go2 bridge（--robot=go2 时使用）
GO2_ENDPOINT=http://127.0.0.1:8013
